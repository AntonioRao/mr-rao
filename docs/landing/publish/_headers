# Security headers — Mr. Rao landing (Cloudflare Pages)
# CSP hashes must match the inline <style> and <script> of BOTH published
# pages exactly: index.html (Italian) and en/index.html (English). A single
# CSP covers /* , so each directive carries one hash per page.
# Recompute with: python docs/landing/publish/_rebuild.py

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: accelerometer=(), autoplay=(), camera=(), display-capture=(), encrypted-media=(), fullscreen=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), midi=(), payment=(), picture-in-picture=(), publickey-credentials-get=(), screen-wake-lock=(), sync-xhr=(), usb=(), web-share=(), xr-spatial-tracking=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self' 'sha256-TCZ0cYJ3rW5lVgizhrSSMXKxn7C9uTTFDTth4ufrQfY=' 'sha256-dv+Z2rgHN3Wws2/v7mtCoTqQVIJZLvIU1bBuGDIiBJc='; style-src 'self' 'sha256-g/UmsYkeyPp6cMY6Vw76VWGaBFgRKju09aZLSp6uH+I=' 'sha256-0P2U21vCMlyyLjipHHTuMkgHlzeOCbRqFISc8qNwL3A='; font-src 'self'; img-src 'self' data:; connect-src 'self'; worker-src 'none'; manifest-src 'self'; upgrade-insecure-requests

/fonts/*
  Cache-Control: public, max-age=31536000, immutable
  X-Content-Type-Options: nosniff
  Cross-Origin-Resource-Policy: same-origin

/assets/*
  Cache-Control: public, max-age=604800
  X-Content-Type-Options: nosniff
  Cross-Origin-Resource-Policy: same-origin

# L'APK di Mr. Rao Mobile.
#
# `Content-Disposition: attachment` perche' senza, alcuni browser tentano di
# aprire un `.apk` invece di scaricarlo, e l'utente si trova davanti un
# errore invece di un file.
#
# La cache e' breve di proposito: il nome del file non porta la versione
# (`/mobile/MrRao.apk` resta lo stesso a ogni rilascio), quindi una cache
# lunga servirebbe la versione vecchia a chi torna. E' lo stesso difetto gia'
# pagato con il logo, ma qui non si puo' risolvere con `?v=`: il link e'
# scritto anche fuori dal sito.
/mobile/MrRao.apk
  Content-Type: application/vnd.android.package-archive
  Content-Disposition: attachment; filename="MrRao.apk"
  Cache-Control: public, max-age=3600
  X-Content-Type-Options: nosniff
